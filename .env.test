# Test Environment Variables for Local Browser Testing

# Database URL for tests (use your local PostgreSQL)
TEST_DATABASE_URL=postgresql+asyncpg://sso_user:sso_password@localhost:5433/sso_db

# Base URL for browser tests
BASE_URL=http://localhost:3000

# Browser test options
HEADED=0  # Set to 1 to see browser window
SLOW=0    # Set to 1 for 2s slow motion

# Testing flag
TESTING=true
