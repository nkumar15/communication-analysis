# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source
*.py text diff=python
*.pyi text diff=python
*.js text
*.jsx text
*.ts text
*.tsx text
*.json text
*.html text diff=html
*.css text
*.scss text
*.md text diff=markdown
*.sh text eol=lf
*.yml text
*.yaml text

# Jupyter notebooks - keep diffable
*.ipynb text -diff

# Windows scripts should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.gz binary

# Lock files should not show diffs by default
package-lock.json -diff linguist-generated
yarn.lock -diff linguist-generated
pnpm-lock.yaml -diff linguist-generated

# GitHub language stats
*.min.js linguist-generated
*.min.css linguist-generated
