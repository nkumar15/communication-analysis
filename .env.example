# Docker Compose Shared Configuration
# These variables are used by multiple services in docker-compose.yml

# PostgreSQL Database Configuration
#SaaS Application Database
POSTGRES_DB=sso_db

#SaaS Application Database Admin user and password. This is for db migration and seed
POSTGRES_USER=sso_user
POSTGRES_PASSWORD=change-this-to-a-secure-password

# SaaS Application Database User and password which is restricted to RLS. This is configured in application
DB_USER=saas_user
DB_PASSWORD=saas_user_password

# Note: Backend-specific config is in backend/.env
# Note: Frontend-specific config is in frontend/.env
