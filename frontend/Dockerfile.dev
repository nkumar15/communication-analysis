# Frontend Dockerfile for Development
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy frontend code
COPY . .

# Expose port for webpack dev server
EXPOSE 3000 3001 3002

# Start webpack dev server
# PORTAL env var is used by webpack.config.js
CMD ["npm", "run", "dev"]
