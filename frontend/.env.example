# Firebase Configuration
# Get these values from Firebase Console → Project Settings → General → Your apps
REACT_APP_FIREBASE_API_KEY=your-api-key-here
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
REACT_APP_FIREBASE_APP_ID=your-app-id

# Backend API URL (Gateway)
REACT_APP_API_URL=http://localhost:8080

# Demo mode (optional): skip the Firebase login screen entirely and
# auto-authenticate with a fixed mock JWT (header.payload.mock_signature).
# Requires the backend to be running with a matching seeded user — see
# infrastructure/auth/firebase.py's mock-token bypass. Leave unset for a
# normal deployment; only meant for local dev / verification.
# REACT_APP_DEMO_AUTO_LOGIN_TOKEN=
