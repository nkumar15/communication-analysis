# Dockerfile for Domain Worker (Heavy dependencies)

# 1. Base Stage
FROM python:3.12-slim AS base
WORKDIR /app

# Install system deps
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Create user
RUN useradd -m -u 1000 appuser && \
    mkdir -p /app/cache/huggingface && \
    chown -R appuser:appuser /app

# 2. Builder Stage
FROM base AS builder
WORKDIR /app

COPY requirements-worker.txt .
COPY requirements.txt .

# Install heavy deps
RUN uv pip install --system --no-cache -r requirements-worker.txt

# 3. Worker Stage
FROM builder AS domain-worker
USER appuser

# Copy code
COPY --chown=appuser:appuser core /app/core
COPY --chown=appuser:appuser infrastructure /app/infrastructure
COPY --chown=appuser:appuser modules /app/modules
COPY --chown=appuser:appuser workers /app/workers
# COPY --chown=appuser:appuser scripts /app/scripts

# Copy .env? (handled by compose env_file usually, but might be needed if python-dotenv loads it)
# We usually don't copy .env in prod, but for local dev it's often mounted or passed.
# Dockerfile usually copies code.

WORKDIR /app
CMD ["celery", "-A", "workers.domain_worker.celery_app", "worker", "--loglevel=info"]
