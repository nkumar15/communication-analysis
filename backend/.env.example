
# ============================================================================
# LEGEND
#   [REQUIRED]     Must be set. The app will not start without this.
#   [REQUIRED:prod] Required in staging/production. Dev default is safe locally.
#   [OPTIONAL]     Has a working default. Override when needed.
#   [DOMAIN:*]     Only needed if that domain use case is enabled.
# ============================================================================
#
# HOW TO USE
#   Local dev:   cp .env.example .env  → fill in REQUIRED values → make up
#   New domain:  uncomment the relevant DOMAIN section at the bottom
#   Production:  follow docs/operations/environment-setup.md
#
# TWO CONFIG FILES (keep both in sync):
#   .env.example            ← this file  (app-level config)
#   ../.env.example         ← root file  (Docker Compose DB credentials only)
# ============================================================================


# ============================================================================
# [REQUIRED] Core
# ============================================================================
ENVIRONMENT=development                      # development | staging | production

# Generate with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALGORITHM=HS256

# ============================================================================
# [REQUIRED] URLs
# ============================================================================
FRONTEND_URL=http://localhost:3000           # B2B portal
FRONTEND_URL_B2C=http://localhost:3001       # B2C portal
FRONTEND_URL_PLATFORM=http://localhost:3002  # Platform admin
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ============================================================================
# [REQUIRED] Database
# ============================================================================
# Must match the credentials in ../.env (Docker Compose postgres service)
DATABASE_URL=postgresql+asyncpg://saas_demo_user:saas_demo_user_password@postgres:5432/saas_demo_db

# ============================================================================
# [REQUIRED] Redis + Celery
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ============================================================================
# [REQUIRED] Authentication — Firebase GCIP
# ============================================================================
# Get from: Firebase Console → Project Settings → General
AUTH_PROVIDER=firebase                       # firebase | mock (mock = testing only)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json
# Also place secrets/firebase-credentials.json (service account JSON) in repo root

# ============================================================================
# [REQUIRED] Email
# ============================================================================
# Local dev:   mailhog (runs in Docker, no setup needed)
# Production:  resend or ses
EMAIL_PROVIDER=mailhog                       # mailhog | resend | ses | console
EMAIL_FROM="Enterprise SSO <noreply@localhost>"

# Mailhog — dev only, no keys needed
MAILHOG_HOST=mailhog
MAILHOG_PORT=1025

# Resend — production
# RESEND_API_KEY=re_...

# AWS SES — production
# AWS_REGION=us-east-1

# ============================================================================
# [REQUIRED] Logging
# ============================================================================
LOG_ENVIRONMENT=local                        # local | test | gcp | aws | production
LOG_LEVEL=INFO

# ============================================================================
# [OPTIONAL] Mobile Deep Linking
# ============================================================================
MOBILE_APP_DOMAIN=app.yourdomain.com
MOBILE_PACKAGE_NAME=com.yourcompany.app

# ============================================================================
# [OPTIONAL] Observability
# ============================================================================
# Sentry — error tracking (leave blank to disable)
# SENTRY_DSN=https://...@sentry.io/...

# OpenTelemetry — Jaeger runs in Docker locally, so this works out of the box
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# ============================================================================
# [OPTIONAL] Payments — Stripe
# Enable only if B2B or B2C billing is active
# Get keys from: Stripe Dashboard → Developers → API Keys
# ============================================================================
PAYMENT_PROVIDER=stripe

# --- B2C Personal Subscriptions ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...         # stripe listen --print-secret
# STRIPE_PRICE_PREMIUM_MONTHLY=price_...
# STRIPE_PRICE_PREMIUM_YEARLY=price_...
# STRIPE_PRICE_ULTIMATE_MONTHLY=price_...
# STRIPE_PRICE_ULTIMATE_YEARLY=price_...

# --- B2B Enterprise Subscriptions ---
# STRIPE_B2B_SECRET_KEY=sk_test_...
# STRIPE_B2B_PUBLISHABLE_KEY=pk_test_...
# STRIPE_B2B_WEBHOOK_SECRET=whsec_...
# STRIPE_B2B_PRICE_STARTER_MONTHLY=price_...
# STRIPE_B2B_PRICE_STARTER_YEARLY=price_...
# STRIPE_B2B_PRICE_PROFESSIONAL_MONTHLY=price_...
# STRIPE_B2B_PRICE_PROFESSIONAL_YEARLY=price_...
# STRIPE_B2B_PRICE_ENTERPRISE_MONTHLY=price_...
# STRIPE_B2B_PRICE_ENTERPRISE_YEARLY=price_...


# ============================================================================
# [DOMAIN: bank_surveillance | marketing_agency | finance_trader]
# AI / RAG — enable if your domain uses LLMs or document search
# Leave commented out if your domain does not use AI (e.g. task_management)
# ============================================================================

# --- LLM Provider (choose one) ---
# LLM_PROVIDER=openai                      # openai | azure_openai | ollama | vertex | mock
# LLM_MODEL=gpt-4o-mini

# OpenAI
# OPENAI_API_KEY=sk-...

# Azure OpenAI
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Ollama — local, zero cost
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_CHAT_MODEL=llama3.2

# --- Embedding Provider (choose one) ---
# EMBEDDING_PROVIDER=openai                # openai | huggingface | ollama | vertex
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# HuggingFace — local, zero cost
# EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_DIM=384
# HF_HOME=/app/.cache/huggingface

# Reranking (optional quality improvement)
# RERANKING_ENABLED=true
# RERANKING_PROVIDER=huggingface
# RERANKING_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Vector Store ---
# VECTOR_STORE_PROVIDER=elasticsearch      # elasticsearch | postgres
# ELASTICSEARCH_URL=http://elasticsearch:9200
# ELASTICSEARCH_INDEX=sso_rag_chunks

# --- Document Storage (MinIO) ---
# MINIO_ENDPOINT=minio:9000
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# MINIO_BUCKET=documents
# MINIO_SECURE=false

# --- Optional AI Services ---
# LLAMA_CLOUD_API_KEY=llx-...             # LlamaParse (advanced PDF parsing)
# DEEPEVAL_API_KEY=...                     # DeepEval (LLM evaluation)
