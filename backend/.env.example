
# ============================================================================
# Core Application Settings
# ============================================================================
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_B2C=http://localhost:3001
FRONTEND_URL_PLATFORM=http://localhost:3002
BACKEND_URL=http://localhost:8000
SECRET_KEY=change_this_to_a_secure_random_string_for_production
ALGORITHM=HS256

# ============================================================================
# Database Configuration
# ============================================================================
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://sso_user:change-this-to-a-secure-password@localhost:5432/sso_db

# ============================================================================
# Redis (Caching & Celery)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_TTL=600  # Cache TTL in seconds (default: 10 minutes)

# Celery Configuration (async task processing)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0


# ============================================================================
# Firebase Admin SDK (Authentication)
# ============================================================================
# Auth provider: firebase (default), mock (for testing)
# For testing: set to 'mock' in .env.test to bypass Firebase
AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to service account JSON (optional if using Google Cloud default credentials)
FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json
# Web API Key for client-side emulation/testing
FIREBASE_API_KEY=your-firebase-web-api-key

# ============================================================================
# Email Infrastructure
# ============================================================================
# Options: mailhog (dev), resend (prod), ses (aws), console (testing)
# For testing: 'mailhog' is already ideal for local test environment
EMAIL_PROVIDER=mailhog
EMAIL_FROM="Enterprise SSO <noreply@localhost>"

# Mailhog Configuration (Local Development)
MAILHOG_HOST=localhost
MAILHOG_PORT=1025

# Resend Configuration (Production)
# RESEND_API_KEY=re_123456789

# AWS SES Configuration
# AWS_REGION=us-east-1

# ============================================================================
# Payment Processing (Stripe)
# ============================================================================
PAYMENT_PROVIDER=stripe

# B2C (Personal/Pro) Stripe Keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# B2B (Tenant/Enterprise) Stripe Keys
STRIPE_B2B_SECRET_KEY=sk_test_...
STRIPE_B2B_PUBLISHABLE_KEY=pk_test_...
STRIPE_B2B_WEBHOOK_SECRET=whsec_...

# B2C Price IDs
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_PREMIUM_YEARLY=price_...
STRIPE_PRICE_ULTIMATE_MONTHLY=price_...
STRIPE_PRICE_ULTIMATE_YEARLY=price_...

# B2B Price IDs
STRIPE_B2B_PRICE_STARTER_MONTHLY=price_...
STRIPE_B2B_PRICE_STARTER_YEARLY=price_...
STRIPE_B2B_PRICE_PROFESSIONAL_MONTHLY=price_...
STRIPE_B2B_PRICE_PROFESSIONAL_YEARLY=price_...
STRIPE_B2B_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_B2B_PRICE_ENTERPRISE_YEARLY=price_...

# ============================================================================
# Observability & Monitoring
# ============================================================================
# Monitoring provider: prometheus (default), datadog, cloudwatch
MONITORING_PROVIDER=prometheus

# Logging Configuration
# Options: local (pretty), test (minimal), gcp, aws, production
# For testing: set to 'test' in .env.test to reduce noise
LOG_ENVIRONMENT=local
LOG_LEVEL=INFO

# Sentry DSN for error tracking
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# OpenTelemetry Endpoint (Jaeger for local dev)
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# ============================================================================
# Testing Configuration
# ============================================================================
# To create a test environment:
# 1. Copy this file to .env.test
# 2. Set AUTH_PROVIDER=mock (bypasses Firebase)
# 3. Set LOG_ENVIRONMENT=test (reduces noise)
# 4. DATABASE_URL will be used automatically (no TEST_DATABASE_URL needed)
#
# Browser Testing (Playwright E2E) - Optional overrides:
# BASE_URL=http://localhost:3000
# HEADED=1        # Show browser window during tests
# SLOW=2000       # Add slow motion for debugging

# ============================================================================
# Mobile App Deep Linking
# ============================================================================
MOBILE_APP_DOMAIN=app.enterprisesso.com
MOBILE_PACKAGE_NAME=com.enterprisesso.app

# ============================================================================
# CORS Configuration
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8000

# ============================================================================
# RAG (Retrieval Augmented Generation) Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# LLM Providers
# ----------------------------------------------------------------------------
# Options: openai (default), azure_openai, ollama, vertex, mock

LLM_PROVIDER=openai
# Recommended Production Model: gpt-4o-mini (Cost/Performance Winner)
LLM_MODEL=gpt-4o-mini

# OpenAI Configuration
OPENAI_API_KEY=sk-...

# Azure OpenAI Configuration
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Ollama Configuration (Local Development)
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_CHAT_MODEL=llama3.2

# ----------------------------------------------------------------------------
# Embedding Configuration
# ----------------------------------------------------------------------------
# Options: openai (default), huggingface, ollama, vertex

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# HuggingFace Local Embeddings (Zero Cost)
# EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_DIM=384
# HF_HOME=/app/.cache/huggingface

# Ollama Embeddings
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIM=768

# ----------------------------------------------------------------------------
# Reranking Configuration (Optional)
# ----------------------------------------------------------------------------
RERANKING_ENABLED=true
RERANKING_PROVIDER=huggingface
RERANKING_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ----------------------------------------------------------------------------
# Vector Store (Elasticsearch)
# ----------------------------------------------------------------------------
VECTOR_STORE_PROVIDER=elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=sso_rag_chunks

# ----------------------------------------------------------------------------
# Document Storage (MinIO S3 Compatible)
# ----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=documents
MINIO_SECURE=false

# ----------------------------------------------------------------------------
# External Services
# ----------------------------------------------------------------------------
# DeepEval (Evaluation Framework)
# DEEPEVAL_API_KEY=...

# LlamaParse (Advanced PDF Parser)
# LLAMA_CLOUD_API_KEY=llx-...

# Azure Document Intelligence (Legacy)
# AZURE_FORM_RECOGNIZER_ENDPOINT="https://<res>.cognitiveservices.azure.com/"
# AZURE_FORM_RECOGNIZER_KEY="..."