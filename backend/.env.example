# Backend Application Configuration

# Security
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Database Connection
# This will be constructed from Docker Compose environment variables
# Format: postgresql://user:password@host:port/database
#DATABASE_URL=postgresql://sso_user:sso_password@postgres:5432/sso_db


POSTGRES_DB=sso_db
POSTGRES_USER=sso_user
POSTGRES_PASSWORD=change-this-to-a-secure-password
