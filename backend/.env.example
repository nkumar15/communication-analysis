
# ============================================================================
# Core Application Settings
# ============================================================================
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_B2C=http://localhost:3001
FRONTEND_URL_PLATFORM=http://localhost:3002
BACKEND_URL=http://localhost:8000
SECRET_KEY=change_this_to_a_secure_random_string_for_production
ALGORITHM=HS256

# ============================================================================
# Database Configuration
# ============================================================================
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://sso_user:change-this-to-a-secure-password@localhost:5432/sso_db

# ============================================================================
# Redis (Caching & Celery)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ============================================================================
# Firebase Admin SDK (Authentication)
# ============================================================================
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to service account JSON (optional if using Google Cloud default credentials)
FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json
# Web API Key for client-side emulation/testing
FIREBASE_API_KEY=your-firebase-web-api-key

# ============================================================================
# Email Infrastructure
# ============================================================================
# Options: mailhog (dev), resend (prod), ses (aws), console (testing)
EMAIL_PROVIDER=mailhog
EMAIL_FROM="Enterprise SSO <noreply@localhost>"

# Mailhog Configuration (Local Development)
MAILHOG_HOST=localhost
MAILHOG_PORT=1025

# Resend Configuration (Production)
# RESEND_API_KEY=re_123456789

# AWS SES Configuration
# AWS_REGION=us-east-1

# ============================================================================
# Payment Processing (Stripe)
# ============================================================================
PAYMENT_PROVIDER=stripe

# B2C (Personal/Pro) Stripe Keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# B2B (Tenant/Enterprise) Stripe Keys
STRIPE_B2B_SECRET_KEY=sk_test_...
STRIPE_B2B_PUBLISHABLE_KEY=pk_test_...
STRIPE_B2B_WEBHOOK_SECRET=whsec_...

# B2C Price IDs
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_PREMIUM_YEARLY=price_...
STRIPE_PRICE_ULTIMATE_MONTHLY=price_...
STRIPE_PRICE_ULTIMATE_YEARLY=price_...

# B2B Price IDs
STRIPE_B2B_PRICE_STARTER_MONTHLY=price_...
STRIPE_B2B_PRICE_STARTER_YEARLY=price_...
STRIPE_B2B_PRICE_PROFESSIONAL_MONTHLY=price_...
STRIPE_B2B_PRICE_PROFESSIONAL_YEARLY=price_...
STRIPE_B2B_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_B2B_PRICE_ENTERPRISE_YEARLY=price_...

# ============================================================================
# Observability & Logging
# ============================================================================
# Options: local, gcp, aws, production
LOG_ENVIRONMENT=local
LOG_LEVEL=INFO
# Sentry DSN for error tracking
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# OpenTelemetry Endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# ============================================================================
# Mobile App Deep Linking
# ============================================================================
MOBILE_APP_DOMAIN=app.enterprisesso.com
MOBILE_PACKAGE_NAME=com.enterprisesso.app

# ============================================================================
# CORS Configuration
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8000