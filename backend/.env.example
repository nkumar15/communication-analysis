# Backend Configuration
# Copy this file to .env and update with your values

# Database
DATABASE_URL=postgresql://sso_user:sso_password@postgres:5432/sso_db

# Security - Generate a secure random key
SECRET_KEY=your-secret-key-change-this-in-production

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-web-api-key

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8001

# Logging Configuration
LOG_ENVIRONMENT=local  # Options: local, gcp, aws, production
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_JSON_INDENT=2  # Pretty print JSON in local dev, use empty for production

# Cloud Provider (when deployed)
# GCP_PROJECT_ID=your-gcp-project-id
# AWS_REGION=us-east-1

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Mobile Deep Links
# Used for activation/invitation emails - must match AndroidManifest.xml host
MOBILE_APP_DOMAIN=app.example.com
# Android package name - used for OAuth callbacks
MOBILE_PACKAGE_NAME=com.saas.b2b

# ------------------------------------------------------------------
# Payment Configuration (B2C)
# ------------------------------------------------------------------

# Provider Selection (stripe, razorpay, xendit)
PAYMENT_PROVIDER=stripe

# Stripe Configuration (Get keys from Stripe Dashboard > Developers > API Keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (Create these in Stripe Dashboard Products)
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_PREMIUM_YEARLY=price_...
STRIPE_PRICE_ULTIMATE_MONTHLY=price_...
STRIPE_PRICE_ULTIMATE_YEARLY=price_...

# Future Providers (Placeholders)
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# XENDIT_SECRET_KEY=xnd_...