# Local Test Configuration (Windows Friendly)
# Usage: 
# 1. Rename this file to ".env" in your backend directory
# 2. Pytest will automatically load it (thanks to python-dotenv usually)
#    OR run: pytest --envfile .env

# ==========================================
# Database Connections (Update password if needed)
# ==========================================
# Used by the Backend App to start up
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/saas_db

# Used by the Test Runner to seed data
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/saas_db

# ==========================================
# App Security (Required for Startup)
# ==========================================
SECRET_KEY=test_secret_key_for_local_development_only
ALGORITHM=HS256

# ==========================================
# URLs (Where things are running)
# ==========================================
# Frontend is running on localhost:3000
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_B2C=http://localhost:3001
FRONTEND_URL_PLATFORM=http://localhost:3002

# Backend is running on localhost:8000
BACKEND_URL=http://localhost:8000

# ==========================================
# Feature Flags
# ==========================================
# Set to 'local' to enable pretty logs
LOG_ENVIRONMENT=local
